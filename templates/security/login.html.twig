{# templates/security/login.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block body %}

    <div class="login-body">
        <div id="login-return-arrow">
            <a class="btn-retour" href="{{ path('home.index') }}">RETOUR</a>
        </div>
        <div class="login-box-header">
            <div class="login-box-title">
                <h2 class="mb-4 text-center" style="letter-spacing: 4px;"><strong>CONNECTION</strong></h2>
            </div>
        </div>
        <div class="login-box">
            {% if error %}
                <div class="alert alert-danger">
                    {{ error.messageKey|trans(error.messageData) }}
                </div>
            {% endif %}

            {{ form_start(form, {'action': path('app_login'),'method': 'POST','attr': {'data-turbo': 'false'} }) }}

                {{ form_row(form._username, {
                    'label_attr': { 'class': 'fw-bold' }
                }) }}

                {{ form_row(form._password, {
                    'label_attr': { 'class': 'fw-bold' }
                }) }}

                {# CSRF Token #}
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <div class="text-center mt-5">
                    {{ form_widget(form.submit, {
                        'attr': {
                            'class': 'btn btn-primary fw-bold px-5 py-2'
                        }
                    }) }}
                </div>

            {{ form_end(form) }}

            <div class="mt-4">
                <a href="{{ path('auth.register') }}" class="text-indigo-600 text-center float-right">Pas encore de compte ? <strong>S'inscrire</strong></a>
            </div>
        </div>
    </div>

{% endblock %}
