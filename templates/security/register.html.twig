{% extends 'base.html.twig' %}

{% block title %}{{ title }}{% endblock %}

{% block body %}

    <div class="register-body">
        <div id="register-return-arrow">
            <a class="btn-retour" href="{{ path('home.index') }}">RETOUR (home)</a>
        </div>
        <div class="register-box-header">
            <div class="register-box-title">
                <h2 class="mb-4 text-center" style="letter-spacing: 4px;"><strong>CRÉER UN COMPTE</strong></h2>
            </div>
        </div>

        <div class="register-box">

            <form id="registerForm">
                <input class="register" type="email" id="email" placeholder="Email" required>
                <input class="register" type="password" id="password" placeholder="Mot de passe" required>
                <input class="register" type="password" id="password_confirm" placeholder="Confirmer le mot de passe" required>

                <div class="text-center mt-5">
                    <button class="btn btn-primary fw-bold px-5 py-2" type="submit">S'inscrire</button>
                </div>

            </form>

            <p id="message"></p>

            <div class="mt-4">
                <a href="{{ path('app_login') }}" class="text-indigo-600 text-center float-right">Déjà un compte ? <strong>Se connecter</strong></a>
            </div>

        </div>
    </div>

    <script>
        document.getElementById('registerForm').addEventListener('submit', async (e) => {
            e.preventDefault();

            const messageDiv = document.getElementById('message');
            messageDiv.textContent = '';

            const formData = {
                email: document.getElementById('email').value,
                password: document.getElementById('password').value,
                password_confirm: document.getElementById('password_confirm').value
            };

            try {
                const response = await fetch('/api/register', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(formData)
                });

                const data = await response.json();

                if (response.ok) {
                    messageDiv.className = 'register-success';
                    messageDiv.textContent = 'Compte créé avec succès ! Redirection...';

                    // Sauvegarde du token
                    localStorage.setItem('jwt_token', data.token);

                    let email = data.user.email;
                    let url = "{{ path('home.new-user') }}" +"?email="+email;

                    setTimeout(() => {
                        window.location.href = url;
                    }, 2000);
                } else {
                    messageDiv.className = 'register-error';
                    messageDiv.textContent = data.message || 'Erreur lors de l\'inscription';
                }
            } catch (err) {
                messageDiv.className = 'error';
                messageDiv.textContent = 'Erreur de connexion au serveur';
            }
        });
    </script>

{% endblock %}
