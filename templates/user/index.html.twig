{% extends 'base.html.twig' %}

{% block title %}{{ title }}{% endblock %}

{% block body %}
    <a class="btn-retour" href="{{ url('home.index') }}">RETOUR (home)</a>
    <br/>

    <div class="user-index-title-ctn">
        <h1 class="user-index-title">Liste de tous les utilisateurs:</h1>
    </div>

    {% if is_granted('ROLE_ADMIN') %}
        <div class="btn btn-primary btn-sm user-index-list-table">
            <a class="user-index-add-a" href="{{ path('user.add') }}">Créer un utilisateur</a>
        </div>
    {% endif %}

    {# Switch Tableau / Cards #}
    <div class="d-flex flex-column">
        <div class="btn-group mb-3" role="group" style="width: 200px;">
            <button type="button"
                    id="btn-table"
                    class="btn btn-outline-primary {% if view_mode == 'table' %}active{% endif %}">
                <i class="fas fa-table"></i> Tableau
            </button>
            <button type="button"
                    id="btn-cards"
                    class="btn btn-outline-primary {% if view_mode == 'cards' %}active{% endif %}">
                <i class="fas fa-th-large"></i> Cartes
            </button>
        </div>

        {# Input qui permet de faire une recherche sur les utilisateurs #}
        <div class="mb-4">
            <form method="GET" class="d-flex gap-2">
                <input type="text"
                       name="search"
                       value="{{ search }}"
                       class="form-control"
                       placeholder="Rechercher par nom ou email ou pays ...">

                {# === Champ caché pour conserver le mode d'affichage === #}
                <input type="hidden"
                       name="view_mode"
                       value="{{ view_mode|default('table') }}">

                <button type="submit" class="btn btn-primary">Rechercher</button>

                {% if search %}
                    <a href="{{ path('user.index', { view_mode: view_mode|default('table') }) }}"
                       class="btn btn-outline-secondary">
                        Effacer
                    </a>
                {% endif %}
            </form>
        </div>
    </div>

    <div class="user-list-container">
        <table class="table user-index-list-table">
            <thead>
            <tr>
                {% if is_granted('ROLE_ADMIN') %}
                    <th>{{ knp_pagination_sortable(users, 'ID', 'u.id') }}</th>
                {% endif %}
                <th>{{ knp_pagination_sortable(users, 'Nom', 'u.name') }}</th>
                <th>{{ knp_pagination_sortable(users, 'Email', 'u.email') }}</th>
                <th>{{ knp_pagination_sortable(users, 'Pays', 'u.country') }}</th>
                <th style="{% if view_mode == 'cards' %} display:none {% endif %}">Action</th>
            </tr>
            </thead>
            {% if view_mode == 'table' %}
                {% for user in users %}
                    <tr>
                        {% if is_granted('ROLE_ADMIN') %}
                            <td>
                                <a class="user-index-list-a text-indigo-600" href="{{ path('user.show', {id:user.id}) }}"> {{ user.id }}</a>
                            </td>
                        {% endif %}
                        <td>
                            <a class="user-index-list-a text-indigo-600" href="{{ path('user.show', {id:user.id}) }}">{{ user.name }}</a>
                        </td>
                        <td>
                            <a class="user-index-list-a text-indigo-600" href="{{ path('user.show', {id:user.id}) }}">{{ user.email }}</a>
                        </td>
                        <td>
                            <a class="user-index-list-a text-indigo-600" href="{{ path('user.show', {id:user.id}) }}">
                                {# Affichage du pays avec extension drapeau + nom complet du pays #}
                                <div class="d-flex align-items-center gap-2">
                                    {% if user.country %}
                                        <img src="https://flagcdn.com/w40/{{ user.country|lower }}.png"
                                             alt="{{ user.country }}"
                                             style="height: 20px; border-radius: 3px;">
                                        <span>
                                                {{ user.country|countryName }}
                                                <small class="text-muted">({{ user.country }})</small>
                                            </span>
                                    {% else %}
                                        Pays non renseigné
                                    {% endif %}
                                </div>
                            </a>
                        </td>
                        <td class="user-index-actions-td">
                            <a class="user-index-list-a text-indigo-600" href="{{ path('user.show', {id:user.id}) }}">Voir</a>

                            {% if is_granted('ROLE_ADMIN') or app.user.id == user.id  %}
                                <a class="user-index-list-a text-indigo-600" href="{{ path('user.edit', {id:user.id}) }}">Editer</a>
                                <form action="{{ path('user.delete', {id:user.id}) }}" method="post">
                                    <input type="hidden" name="_method" value="DELETE">
                                    <button type="submit" class="btn btn-danger btn-sm">Supprimer</button>
                                </form>
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
        </table>
    </div>
            {% elseif view_mode == 'cards' %}
            {#on ferme notre tableau, puis on affiche nos cards #}
        </table>
    </div>
        <div id="view-cards" class="{% if view_mode != 'cards' %}d-none{% endif %} mb-5">
            <div class="row row-cols-1 row-cols-md-3 row-cols-lg-4 g-4">
                {% for user in users %}
                    <div class="col">
                        <div class="card h-100 shadow-sm">
                            {# Preview image ou icône #}
                            <div class="card-img-top bg-light d-flex align-items-center justify-content-center" style="height: 180px;">
                                {% if user.image is not null %}
                                    <img src="data:{{ user.imageMime|default('image/jpeg') }};base64,{{ user.image|base64_encode }}"
                                         alt="Photo de {{ user.name }}"
                                         class="rounded-circle border border-3 border-white shadow-sm"
                                         style="width: 180px; height: 180px; object-fit: cover; margin: 0 auto;">
                                {% else %}
                                    <div class="rounded-circle bg-light d-flex align-items-center justify-content-center mx-auto shadow-sm"
                                         style="width: 180px; height: 180px; font-size: 4rem;">
                                        👤
                                    </div>
                                {% endif %}
                            </div>
                            <div class="card-body">
                                <h6 class="card-title text-center"><strong>{{ user.name }}</strong></h6>
                                <div class="d-flex align-items-center flex-column">
                                    {# Affichage du pays avec extension drapeau + nom complet du pays #}
                                    <div class="d-flex align-items-center gap-2">
                                        {% if user.country %}
                                            <img src="https://flagcdn.com/w40/{{ user.country|lower }}.png"
                                                 alt="{{ user.country }}"
                                                 style="height: 20px; border-radius: 3px;">
                                            <span>
                                                {{ user.country|countryName }}
                                                <small class="text-muted">({{ user.country }})</small>
                                            </span>
                                        {% else %}
                                            <span class="text-muted">Pays non renseigné</span>
                                        {% endif %}
                                    </div>
                                    <br/>
                                    <small>Email: <strong>{{ user.email  }}</strong></small>
                                </div>
                            </div>

                            <a class="user-index-list-a text-indigo-600 text-center" href="{{ path('user.show', {id:user.id}) }}">Voir</a>

                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
        {% endif %}

    {#
    <div class="d-flex">
        {% if page > 1 %}
            <a href="{{ path('user.index', {page: page - 1}) }}" class="btn btn-secondary">Page Précédante</a>
        {% endif %}
        {% if page < maxPage %}
            <a href="{{ path('user.index', {page: page + 1}) }}" class="btn btn-secondary">Page Suivante</a>
        {% endif %}
    </div>
    #}

    {% if users is empty %}
        <div class="col-12">
            <div class="alert alert-info text-center">
                <strong>Il n'y a aucun utilisateur!</strong>
            </div>
        </div>
    {% endif %}

    <div class="pagination_container">
        {{ knp_pagination_render(users) }}
    </div>

    {% block javascripts %}
        {{ parent() }}   {# ← Très important #}
        <script>
            //JS pour switcher nos affichages sans perdre nos paramètres (cas table->cards)
            document.getElementById('btn-table')?.addEventListener('click', async () => {
                const url = new URL(window.location.href);
                url.searchParams.set("view_mode", "table");
                window.location.href = url.toString();
            });

            //JS pour switcher nos affichages sans perdre nos paramètres (cas cards->table)
            document.getElementById('btn-cards')?.addEventListener('click', async () => {
                const url = new URL(window.location.href);
                url.searchParams.set("view_mode", "cards");
                window.location.href = url.toString();
            });
        </script>
    {% endblock %}

{% endblock %}
